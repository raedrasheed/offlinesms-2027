# OfflineSMS — root env (used by scripts/seed.ts and Firebase tooling)
# Copy to .env and fill in. See docs/FIREBASE_SETUP.md.

# Service account JSON path (download from Firebase Console → Settings → Service accounts).
# Used by scripts/seed.ts and scripts/promoteAdmin.ts. Keep this file out of git.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
FIREBASE_PROJECT_ID=offlinesms-prod

# ── Email OTP delivery (Cloud Functions) — see docs/OFFLINESMS_EMAIL_OTP.md ──
# Provider: 'resend' (default) or 'console' (local/dev: no real send, no code logged).
EMAIL_PROVIDER=resend
# Resend API key (https://resend.com → API Keys). Set via Functions env / Secret Manager.
RESEND_API_KEY=
# Verified sender, e.g. "OfflineSMS <noreply@yourdomain.com>".
EMAIL_FROM=
