{
  "name": "offlinesms",
  "version": "0.1.0",
  "private": true,
  "//workspaces": "apps/mobile is intentionally NOT a workspace: its Expo SDK 53 dependency and React versions must stay independent of dashboard upgrades. Mobile is installed standalone with its own package-lock.json, preventing npm root hoisting from changing its Expo-compatible tree. See docs/OFFLINESMS_16KB_PAGE_SIZE_UPGRADE.md for the original isolation decision.",
  "workspaces": [
    "apps/dashboard",
    "packages/*",
    "functions"
  ],
  "scripts": {
    "dev:mobile": "npm --prefix apps/mobile run web",
    "dev:dashboard": "npm --workspace apps/dashboard run dev",
    "dev:functions": "npm --workspace functions run serve",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "i18n:check": "tsx scripts/checkI18n.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:rules": "vitest run --config vitest.rules.config.ts",
    "pretest:integration": "npm --workspace functions run build",
    "test:integration": "firebase emulators:exec --project demo-offlinesms --only firestore,auth,storage \"vitest run --config vitest.integration.config.ts\"",
    "test:callable": "bash scripts/ci/runCallableTests.sh",
    "validate": "npm run typecheck && npm run lint && npm run i18n:check && npm run test && npm run build",
    "seed": "tsx scripts/seed.ts",
    "seed:review": "tsx scripts/seedReviewDemo.ts",
    "verify:userprivate": "tsx scripts/verifyUserPrivateBackfill.ts",
    "cleanup:public-pii": "tsx scripts/cleanupPublicPii.ts",
    "verify:public-pii-cleanup": "tsx scripts/verifyPublicPiiCleanup.ts",
    "promote:admin": "tsx scripts/promoteAdmin.ts",
    "firebase:emulators": "firebase emulators:start",
    "firebase:deploy": "firebase deploy"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/sql.js": "^1.4.9",
    "firebase-tools": "^13.21.0",
    "sql.js": "^1.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=20"
  }
}
