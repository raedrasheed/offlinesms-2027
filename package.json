{
  "name": "offlinesms",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "functions"
  ],
  "scripts": {
    "postinstall": "patch-package",
    "dev:mobile": "npm --workspace apps/mobile run web",
    "dev:dashboard": "npm --workspace apps/dashboard run dev",
    "dev:functions": "npm --workspace functions run serve",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "i18n:check": "tsx scripts/checkI18n.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:rules": "vitest run --config vitest.rules.config.ts",
    "validate": "npm run typecheck && npm run lint && npm run i18n:check && npm run test && npm run build",
    "seed": "tsx scripts/seed.ts",
    "promote:admin": "tsx scripts/promoteAdmin.ts",
    "firebase:emulators": "firebase emulators:start",
    "firebase:deploy": "firebase deploy"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase-tools": "^13.21.0",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=20"
  }
}
