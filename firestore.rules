rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }
    function isSignedIn() { return isAuthed(); }
    function isSelf(uid) {
      return isAuthed() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isAuthed() && request.auth.token.admin == true;
    }
    function isMember(convoId) {
      return isAuthed() &&
        exists(/databases/$(database)/documents/conversations/$(convoId)/members/$(request.auth.uid));
    }
    function isGroupAdmin(convoId) {
      return isAuthed() &&
        get(/databases/$(database)/documents/conversations/$(convoId)/members/$(request.auth.uid)).data.role in ['admin', 'owner'];
    }

    // --------------------------------------------------------------
    // User profile field allow-list.
    //
    // Phase 2 hardens client writes on `users/{uid}` so:
    //   - Only known profile fields can be set/changed by the user.
    //   - Sensitive fields (role/admin/wallet/security flags) can only
    //     be written by callables running with admin privileges.
    //   - Username uniqueness is delegated to the `claimUsername`
    //     callable; clients cannot write to /usernames/* directly.
    // --------------------------------------------------------------
    function allowedProfileFields() {
      // Note: `username` and `usernameLower` are deliberately omitted.
      // They can only be written by the `claimUsername` callable (which
      // runs via the Admin SDK and bypasses these rules).
      return [
        'displayName', 'photoURL', 'about', 'profileCompleted',
        'fcmTokens', 'lastSeen', 'updatedAt'
      ];
    }
    function bannedProfileFields() {
      // Fields the client must NEVER set or change directly. These are
      // server-owned (set by callables / triggers / scripts).
      return [
        'role', 'roles', 'permissions', 'admin', 'isAdmin',
        'points', 'pointsBalance', 'wallet', 'walletStatus',
        'organizationId', 'organizationRole',
        'createdAt', 'phoneVerified', 'status',
        'phoneNumber', 'email',                 // identity fields — server-owned
        'username', 'usernameLower'             // forced through claimUsername callable
      ];
    }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function changedKeysOnCreate() {
      return request.resource.data.keys();
    }
    function onlyAllowedUserProfileUpdates() {
      // Every changed key must be in the allow-list. The banned-list is
      // a redundant safety net that flags anything that managed to slip
      // past the allow-list (e.g. by mistake during future edits).
      return changedKeys().hasOnly(allowedProfileFields())
          && !changedKeys().hasAny(bannedProfileFields());
    }
    function safeUserProfileCreate() {
      // On create, allow the small set of fields the user can carry in
      // from auth; everything else is server-owned.
      return changedKeysOnCreate().hasOnly([
        'displayName', 'phoneNumber', 'email',
        'createdAt', 'status'
      ]);
    }

    // USERS — profile readable by anyone authed; writeable only by self
    // under the field allow-list, or by admins.
    match /users/{uid} {
      allow read:   if isAuthed();
      allow create: if (isSelf(uid) && safeUserProfileCreate()) || isAdmin();
      allow update: if isAdmin() ||
                       (isSelf(uid) && onlyAllowedUserProfileUpdates());
      allow delete: if isAdmin();
    }

    // USERNAMES — read by any signed-in user (so the app can show "taken"
    // status before submission). Writes go through the `claimUsername`
    // callable only; admins keep an escape hatch for moderation.
    match /usernames/{usernameLower} {
      allow read:  if isAuthed();
      allow write: if isAdmin();
    }

    // CONVERSATIONS
    match /conversations/{convoId} {
      allow read: if isMember(convoId) || isAdmin();
      allow create: if isAuthed();
      allow update: if isMember(convoId) || isAdmin();
      allow delete: if isGroupAdmin(convoId) || isAdmin();

      match /members/{uid} {
        allow read: if isMember(convoId) || isAdmin();
        allow write: if isGroupAdmin(convoId) || isSelf(uid) || isAdmin();
      }

      match /messages/{messageId} {
        allow read: if isMember(convoId) || isAdmin();
        allow create: if isMember(convoId) && request.resource.data.senderId == request.auth.uid;
        allow update: if isAdmin() ||
                       (isMember(convoId) && resource.data.senderId == request.auth.uid);
        allow delete: if isAdmin() ||
                       (isMember(convoId) && resource.data.senderId == request.auth.uid);

        // Receipts (per recipient)
        match /receipts/{uid} {
          allow read: if isMember(convoId);
          allow write: if isSelf(uid) || isAdmin(); // own receipts only
        }
      }
    }

    // POINTS — wallets, transactions
    match /wallets/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if isAdmin();                       // mutated via Cloud Function
    }
    match /transactions/{txId} {
      allow read: if isAuthed() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();                       // via Cloud Function
    }

    // SMS BATCHES
    match /smsBatches/{batchId} {
      allow read: if isAuthed() && (resource.data.senderId == request.auth.uid || isAdmin());
      allow write: if isAdmin();                       // via Cloud Function

      match /recipients/{recipientId} {
        allow read: if isAuthed();
        allow write: if isAdmin();
      }
    }

    // STATUS posts
    match /statuses/{statusId} {
      allow read: if isAuthed();
      allow create: if isAuthed() && request.resource.data.authorId == request.auth.uid;
      allow delete: if isAuthed() && resource.data.authorId == request.auth.uid;
    }

    // ADMIN settings
    match /settings/{doc} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }
  }
}
