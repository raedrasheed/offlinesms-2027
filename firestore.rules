rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ────────────────────────────────────────────────────────────
    // Identity helpers
    // ────────────────────────────────────────────────────────────
    function isAuthed()      { return request.auth != null; }
    function isSignedIn()    { return isAuthed(); }
    function isSelf(uid)     { return isAuthed() && request.auth.uid == uid; }
    function isAdmin()       { return isAuthed() && request.auth.token.admin == true; }
    function hasAdminRole()  { return isAdmin(); }   // alias for readability

    function isMember(convoId) {
      return isAuthed() &&
        exists(/databases/$(database)/documents/conversations/$(convoId)/members/$(request.auth.uid));
    }
    function isGroupAdmin(convoId) {
      return isAuthed() &&
        get(/databases/$(database)/documents/conversations/$(convoId)/members/$(request.auth.uid)).data.role in ['admin', 'owner'];
    }

    // ────────────────────────────────────────────────────────────
    // User profile field allow-list (Phase 2)
    // ────────────────────────────────────────────────────────────
    function allowedProfileFields() {
      // `username` / `usernameLower` deliberately omitted — only the
      // `claimUsername` callable (Admin SDK) writes those.
      return [
        'displayName', 'photoURL', 'about', 'profileCompleted',
        'fcmTokens', 'lastSeen', 'updatedAt'
      ];
    }
    function bannedProfileFields() {
      return [
        'role', 'roles', 'permissions', 'admin', 'isAdmin',
        'points', 'pointsBalance', 'wallet', 'walletStatus',
        'organizationId', 'organizationRole',
        'createdAt', 'phoneVerified', 'status',
        'phoneNumber', 'email',
        'username', 'usernameLower'
      ];
    }
    function changedKeys()          { return request.resource.data.diff(resource.data).affectedKeys(); }
    function changedKeysOnCreate()  { return request.resource.data.keys(); }
    function onlyAllowedUserProfileUpdates() {
      return changedKeys().hasOnly(allowedProfileFields())
          && !changedKeys().hasAny(bannedProfileFields());
    }
    function safeUserProfileCreate() {
      return changedKeysOnCreate().hasOnly([
        'displayName', 'phoneNumber', 'email', 'createdAt', 'status'
      ]);
    }

    // ────────────────────────────────────────────────────────────
    // Receipt enum (Phase 3)
    // ────────────────────────────────────────────────────────────
    function isValidReceiptStatus(s) {
      return s in ['pending', 'delivered', 'read', 'viewed', 'played', 'failed'];
    }

    // ────────────────────────────────────────────────────────────
    // Status audience + expiry (Phase 3)
    // ────────────────────────────────────────────────────────────
    function isStatusExpired(s) {
      // `expiresAt` is a server timestamp. Missing => treat as non-expired
      // (legacy docs) but a present timestamp in the past blocks the read.
      return ('expiresAt' in s) && s.expiresAt != null && s.expiresAt < request.time;
    }
    function isStatusAudienceMember(s) {
      // Default semantics (no audience fields): readable by any signed-in
      // user — matches the pre-Phase-3 behaviour while still gated by the
      // top-level auth check.
      return !('audienceType' in s) ||
             (s.audienceType == 'all_contacts'
                && !( ('excludedViewerUids' in s) && request.auth.uid in s.excludedViewerUids )) ||
             (s.audienceType == 'contacts_except'
                && !( ('excludedViewerUids' in s) && request.auth.uid in s.excludedViewerUids )) ||
             (s.audienceType == 'only_share_with'
                && ('allowedViewerUids' in s) && request.auth.uid in s.allowedViewerUids);
    }
    function isStatusAuthor(s) {
      return isAuthed() && s.authorId == request.auth.uid;
    }

    // ════════════════════════════════════════════════════════════
    // USERS
    // ════════════════════════════════════════════════════════════
    match /users/{uid} {
      allow read:   if isAuthed();
      allow create: if (isSelf(uid) && safeUserProfileCreate()) || isAdmin();
      allow update: if isAdmin() ||
                       (isSelf(uid) && onlyAllowedUserProfileUpdates());
      allow delete: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════
    // USERNAMES — lookup table for `claimUsername` callable
    // ════════════════════════════════════════════════════════════
    match /usernames/{usernameLower} {
      allow read:  if isAuthed();
      allow write: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════
    // CONVERSATIONS
    // ════════════════════════════════════════════════════════════
    match /conversations/{convoId} {
      allow read:   if isMember(convoId) || isAdmin();
      allow create: if isAuthed();
      allow update: if isMember(convoId) || isAdmin();
      allow delete: if isGroupAdmin(convoId) || isAdmin();

      match /members/{uid} {
        allow read:  if isMember(convoId) || isAdmin();
        allow write: if isGroupAdmin(convoId) || isSelf(uid) || isAdmin();
      }

      match /messages/{messageId} {
        allow read:   if isMember(convoId) || isAdmin();
        allow create: if isMember(convoId) && request.resource.data.senderId == request.auth.uid;
        allow update: if isAdmin() ||
                       (isMember(convoId) && resource.data.senderId == request.auth.uid);
        allow delete: if isAdmin() ||
                       (isMember(convoId) && resource.data.senderId == request.auth.uid);

        // Receipts (per recipient). Phase 3 adds the status enum check.
        match /receipts/{uid} {
          allow read:   if isMember(convoId);
          allow create: if (isSelf(uid) || isAdmin())
                          && (!('status' in request.resource.data)
                              || isValidReceiptStatus(request.resource.data.status));
          allow update: if (isSelf(uid) || isAdmin())
                          && (!('status' in request.resource.data)
                              || isValidReceiptStatus(request.resource.data.status));
          allow delete: if isAdmin();
        }
      }
    }

    // ════════════════════════════════════════════════════════════
    // POINTS — wallets, transactions
    // ════════════════════════════════════════════════════════════
    match /wallets/{uid} {
      allow read:  if isSelf(uid) || isAdmin();
      allow write: if isAdmin();
    }
    match /transactions/{txId} {
      allow read:  if isAuthed() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════
    // SMS BATCHES
    // ════════════════════════════════════════════════════════════
    match /smsBatches/{batchId} {
      allow read:  if isAuthed() && (resource.data.senderId == request.auth.uid || isAdmin());
      allow write: if isAdmin();

      match /recipients/{recipientId} {
        allow read:  if isAuthed();
        allow write: if isAdmin();
      }
    }

    // ════════════════════════════════════════════════════════════
    // STATUSES — Phase 3 audience + expiry enforcement
    // ════════════════════════════════════════════════════════════
    match /statuses/{statusId} {
      allow read:   if isAdmin()
                    || (isAuthed()
                        && isStatusAuthor(resource.data))
                    || (isAuthed()
                        && !isStatusExpired(resource.data)
                        && isStatusAudienceMember(resource.data));

      allow create: if isAuthed()
                    && request.resource.data.authorId == request.auth.uid;

      allow update: if isAdmin()
                    || (isAuthed() && resource.data.authorId == request.auth.uid);

      allow delete: if isAdmin()
                    || (isAuthed() && resource.data.authorId == request.auth.uid);
    }

    // ════════════════════════════════════════════════════════════
    // ADMIN settings
    // ════════════════════════════════════════════════════════════
    match /settings/{doc} {
      allow read:  if isAuthed();
      allow write: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════
    // ORGANIZATIONS (Phase 3 scaffold — admin-only until Phase 13)
    // ════════════════════════════════════════════════════════════
    match /organizations/{organizationId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();

      match /members/{uid} {
        allow read:  if isAdmin() || isSelf(uid);
        allow write: if isAdmin();
      }
    }

    // ════════════════════════════════════════════════════════════
    // ROLES (catalogue; live permission checks read from custom claims)
    // ════════════════════════════════════════════════════════════
    match /roles/{roleId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════
    // AUDIT LOGS — server-owned. Clients (incl. admins via web SDK)
    // cannot write here. Writes always go through writeAuditLog().
    // ════════════════════════════════════════════════════════════
    match /auditLogs/{auditLogId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ════════════════════════════════════════════════════════════
    // TICKETS — owner creates, owner/admin read, admin updates.
    // ════════════════════════════════════════════════════════════
    match /tickets/{ticketId} {
      allow read:   if isAdmin() ||
                       (isAuthed() && resource.data.createdBy == request.auth.uid);
      allow create: if isAuthed()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.status == 'open'
                    && !('assignedTo' in request.resource.data);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════
    // FLAGS — owner creates, admin reads/updates.
    // ════════════════════════════════════════════════════════════
    match /flags/{flagId} {
      allow read:   if isAdmin();
      allow create: if isAuthed()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.status == 'open';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════
    // PAYMENTS — requester read, server-only write (even for admins,
    // so idempotency stays in one webhook codepath in Phase 10).
    // ════════════════════════════════════════════════════════════
    match /payments/{paymentId} {
      allow read:  if isAdmin() ||
                      (isAuthed() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // ════════════════════════════════════════════════════════════
    // GATEWAY HEALTH — admin read, server-only write.
    // ════════════════════════════════════════════════════════════
    match /gatewayHealth/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ════════════════════════════════════════════════════════════
    // SMS QUOTA USAGE — requester reads own; server-only write.
    // Stored under per-user roots so listing per-user is cheap.
    // ════════════════════════════════════════════════════════════
    match /smsQuotaUsage/{uid} {
      allow read:  if isSelf(uid) || isAdmin();
      allow write: if false;

      match /days/{yyyymmdd} {
        allow read:  if isSelf(uid) || isAdmin();
        allow write: if false;
      }
    }
  }
}
