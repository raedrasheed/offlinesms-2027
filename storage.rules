rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthed() { return request.auth != null; }
    function isSelf(uid) { return isAuthed() && request.auth.uid == uid; }

    // Uploads belong to a live message reservation. Retention marks that
    // reservation before cleanup so a stale client cannot recreate its files.
    function isAllowedMediaMime(ct) {
      return ct in [
        'image/jpeg', 'image/png', 'image/webp',
        'audio/m4a', 'audio/aac', 'audio/mp4', 'audio/x-m4a'
      ];
    }
    match /chatMedia/{conversationId}/{senderId}/{messageId}/{file} {
      allow read:  if isAuthed();
      allow write: if isAuthed() && request.auth.uid == senderId
                      && firestore.exists(/databases/(default)/documents/conversations/$(conversationId)/messages/$(messageId))
                      && firestore.get(/databases/(default)/documents/conversations/$(conversationId)/messages/$(messageId)).data.get('retentionDeleting', false) != true
                      && request.resource.size < 10 * 1024 * 1024
                      && isAllowedMediaMime(request.resource.contentType);
    }

    // Avatars
    match /avatars/{uid}/{file} {
      allow read: if isAuthed();
      allow write: if isSelf(uid) && request.resource.size < 5 * 1024 * 1024;
    }

    // Group avatars — uploaded by a member to their own subpath (uid in the
    // path authorizes the write, like chatMedia). The image only becomes the
    // group's avatar when an owner/admin's updateGroupInfo callable stores the
    // URL on the conversation doc, so a non-admin upload has no effect.
    match /groupAvatars/{conversationId}/{uid}/{file} {
      allow read:  if isAuthed();
      allow write: if isSelf(uid) && request.resource.size < 5 * 1024 * 1024
                      && isAllowedMediaMime(request.resource.contentType);
    }

    // Conversation media — uploader must be authed; size < 30MB
    match /conversations/{convoId}/{senderId}/{file} {
      allow read: if isAuthed();
      allow write: if isAuthed() && request.auth.uid == senderId &&
                       request.resource.size < 30 * 1024 * 1024;
    }

    // Status media — image/video statuses; metadata is validated again by the
    // createStatus callable. Caps mirror functions/src/statuses/statusLogic.ts.
    function isAllowedStatusMime(ct) {
      return ct in [
        'image/jpeg', 'image/png', 'image/webp',
        'video/mp4', 'video/quicktime', 'video/webm'
      ];
    }
    match /statuses/{uid}/{file} {
      allow read: if isAuthed();
      allow write: if isSelf(uid) && request.resource.size < 15 * 1024 * 1024
                      && isAllowedStatusMime(request.resource.contentType);
    }
  }
}
