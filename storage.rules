rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthed() { return request.auth != null; }
    function isSelf(uid) { return isAuthed() && request.auth.uid == uid; }

    // Uploads belong to a live message reservation. Retention marks that
    // reservation before cleanup so a stale client cannot recreate its files.
    function isAllowedMediaMime(ct) {
      return ct in [
        'image/jpeg', 'image/png', 'image/webp',
        'audio/m4a', 'audio/aac', 'audio/mp4', 'audio/x-m4a'
      ];
    }
    function activeParticipant(conversationId) {
      let c = firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data;
      return isAuthed() && request.auth.uid in c.get('participantUids', c.get('memberIds', []))
        && (c.get('type', 'direct') != 'group' ||
          firestore.get(/databases/(default)/documents/conversations/$(conversationId)/members/$(request.auth.uid)).data.get('status', 'active') == 'active');
    }
    match /chatMedia/{conversationId}/{senderId}/{messageId}/{file} {
      function message() { return firestore.get(/databases/(default)/documents/conversations/$(conversationId)/messages/$(messageId)).data; }
      allow read: if activeParticipant(conversationId)
        && message().get('deletedForEveryone', false) != true
        && message().get('retentionDeleting', false) != true
        && (message().media.uploadStatus == 'uploaded' || request.auth.uid == senderId);
      allow write: if resource == null && request.resource != null && isSelf(senderId) && activeParticipant(conversationId)
        && message().senderUid == senderId
        && message().get('deletedForEveryone', false) != true
        && message().get('retentionDeleting', false) != true
        && message().media.uploadStatus == 'pending'
        && message().media.storagePath == 'chatMedia/' + conversationId + '/' + senderId + '/' + messageId + '/' + file
        && request.resource.contentType == message().media.mimeType
        && request.resource.size == message().media.sizeBytes
        && request.resource.size > 0
        && request.resource.size <= (message().type in ['image', 'voice'] ? 10 : 25) * 1024 * 1024;
    }

    // Short-video originals may be uploaded only into a server reservation.
    // Restarting an interrupted upload may replace the original while it is
    // still uploading/failed, but publishing freezes that path. Originals and
    // processed outputs deny direct SDK reads. The playback callable checks
    // current permissions before issuing a short signed URL, and processing
    // strips automatically created download tokens. Storage rules can read at
    // most two Firestore documents: the reservation and publisher profile.
    // Account/master-policy checks happen at reservation, publish and processing;
    // already issued private source leases last until uploadExpiresAt.
    match /clipUploads/{uid}/{clipId}/source {
      function canUploadSource() {
        // Bind each document once to stay within the two-call limit.
        let publisher = firestore.get(/databases/(default)/documents/clipProfiles/$(uid)).data;
        let reservation = firestore.get(/databases/(default)/documents/clips/$(clipId)).data;
        return publisher.get('suspended', false) != true
          && publisher.get('deleting', false) != true
          && reservation.ownerUid == uid
          && reservation.status in ['uploading', 'failed']
          && reservation.sourcePath == 'clipUploads/' + uid + '/' + clipId + '/source'
          && reservation.uploadExpiresAt > request.time
          && request.resource.size > 0
          && request.resource.size <= reservation.maxUploadBytes
          && request.resource.size <= 200 * 1024 * 1024
          && request.resource.contentType in ['video/mp4', 'video/quicktime', 'video/webm']
          && request.resource.metadata.keys().hasOnly([]);
      }
      allow read: if false;
      allow write: if isSelf(uid) && request.resource != null && canUploadSource();
    }
    match /clipMedia/{path=**} {
      allow read, write: if false;
    }

    // Avatars
    match /avatars/{uid}/{file} {
      allow read: if isAuthed();
      allow write: if isSelf(uid) && request.resource.size < 5 * 1024 * 1024;
    }

    // Group avatars — uploaded by a member to their own subpath (uid in the
    // path authorizes the write, like chatMedia). The image only becomes the
    // group's avatar when an owner/admin's updateGroupInfo callable stores the
    // URL on the conversation doc, so a non-admin upload has no effect.
    match /groupAvatars/{conversationId}/{uid}/{file} {
      allow read:  if isAuthed();
      allow write: if isSelf(uid) && request.resource.size < 5 * 1024 * 1024
                      && isAllowedMediaMime(request.resource.contentType);
    }

    // Conversation media — uploader must be authed; size < 30MB
    match /conversations/{convoId}/{senderId}/{file} {
      allow read: if isAuthed();
      allow write: if isAuthed() && request.auth.uid == senderId &&
                       request.resource.size < 30 * 1024 * 1024;
    }

    // Status media — image/video statuses; metadata is validated again by the
    // createStatus callable. Caps mirror functions/src/statuses/statusLogic.ts.
    function isAllowedStatusMime(ct) {
      return ct in [
        'image/jpeg', 'image/png', 'image/webp',
        'video/mp4', 'video/quicktime', 'video/webm'
      ];
    }
    match /statuses/{uid}/{file} {
      allow read: if isAuthed();
      allow write: if isSelf(uid) && request.resource.size < 15 * 1024 * 1024
                      && isAllowedStatusMime(request.resource.contentType);
    }
  }
}
