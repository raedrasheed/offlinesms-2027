rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthed() { return request.auth != null; }
    function isSelf(uid) { return isAuthed() && request.auth.uid == uid; }

    // Phase 23 — chat media (images & voice notes). Read: conversation members.
    // Write: the message's sender only (the message doc is created by
    // createMediaMessage before upload). Size <= 10MB and a strict MIME allow-list.
    function convoData(cid) {
      return firestore.get(/databases/(default)/documents/conversations/$(cid)).data;
    }
    function isMember(cid) {
      return isAuthed() && (
        (('participantUids' in convoData(cid)) && (request.auth.uid in convoData(cid).participantUids)) ||
        (('memberIds' in convoData(cid)) && (request.auth.uid in convoData(cid).memberIds))
      );
    }
    function isMessageSender(cid, mid) {
      return isAuthed()
        && firestore.exists(/databases/(default)/documents/conversations/$(cid)/messages/$(mid))
        && firestore.get(/databases/(default)/documents/conversations/$(cid)/messages/$(mid)).data.senderUid == request.auth.uid;
    }
    function isAllowedMediaMime(ct) {
      return ct in [
        'image/jpeg', 'image/png', 'image/webp',
        'audio/m4a', 'audio/aac', 'audio/mp4', 'audio/x-m4a'
      ];
    }
    match /chatMedia/{conversationId}/{messageId}/{file} {
      allow read:  if isMember(conversationId);
      allow write: if isMessageSender(conversationId, messageId)
                      && request.resource.size < 10 * 1024 * 1024
                      && isAllowedMediaMime(request.resource.contentType);
    }

    // Avatars
    match /avatars/{uid}/{file} {
      allow read: if isAuthed();
      allow write: if isSelf(uid) && request.resource.size < 5 * 1024 * 1024;
    }

    // Conversation media — uploader must be authed; size < 30MB
    match /conversations/{convoId}/{senderId}/{file} {
      allow read: if isAuthed();
      allow write: if isAuthed() && request.auth.uid == senderId &&
                       request.resource.size < 30 * 1024 * 1024;
    }

    // Status media — 24h auto-expiry handled by Cloud Function
    match /statuses/{uid}/{file} {
      allow read: if isAuthed();
      allow write: if isSelf(uid) && request.resource.size < 15 * 1024 * 1024;
    }
  }
}
