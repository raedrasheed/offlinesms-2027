<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView android:id="@+id/statusText"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textStyle="bold" />

        <LinearLayout android:id="@+id/batteryWarn"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone"
            android:layout_marginTop="14dp" android:padding="12dp"
            android:background="#FEF3C7">
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/battery_warning" android:textColor="#92400E" />
            <Button android:id="@+id/batteryFixBtn"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/battery_fix" />
        </LinearLayout>

        <TextView android:id="@+id/businessText"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />
        <TextView android:id="@+id/deviceText"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />
        <TextView android:id="@+id/queueText"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <Button android:id="@+id/pauseBtn"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/dash_pause" />

        <Button android:id="@+id/revokeBtn"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/dash_revoke" />

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/dash_logs" android:textStyle="bold" />
        <TextView android:id="@+id/logsText"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:fontFamily="monospace" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
