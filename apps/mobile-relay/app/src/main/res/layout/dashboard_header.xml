<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header scrolls with the activity list, including at large font sizes. -->
    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:src="@drawable/ic_logo_mark"
        android:contentDescription="@string/app_name" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/app_name"
        android:textColor="@color/brand_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView android:id="@+id/statusText"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:gravity="center" android:textStyle="bold" />

    <LinearLayout android:id="@+id/batteryWarn"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:visibility="gone"
        android:layout_marginTop="14dp" android:padding="12dp"
        android:background="#FEF3C7">
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/battery_warning" android:textColor="#92400E" />
        <Button android:id="@+id/batteryFixBtn"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/battery_fix" />
    </LinearLayout>

    <TextView android:id="@+id/businessText"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" />
    <TextView android:id="@+id/deviceText"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />
    <TextView android:id="@+id/queueText"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <Button android:id="@+id/pauseBtn"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:text="@string/dash_pause" />

    <Button android:id="@+id/revokeBtn"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="@string/dash_revoke" />

    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:text="@string/dash_logs" android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="@string/logs_hint"
        android:textSize="14sp" />
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="8dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/logsAllBtn"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:minHeight="48dp" android:checkable="true" android:text="@string/logs_all" />
        <com.google.android.material.button.MaterialButton android:id="@+id/logsProblemsBtn"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:minHeight="48dp"
            android:checkable="true" android:text="@string/logs_problems" />
    </LinearLayout>
    <TextView android:id="@+id/logsEmptyText"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="20dp" android:paddingBottom="20dp"
        android:textSize="16sp" android:text="@string/logs_loading" />
</LinearLayout>
