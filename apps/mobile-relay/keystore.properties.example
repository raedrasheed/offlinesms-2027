# Copy this file to keystore.properties (same folder) and fill in your values.
# keystore.properties is gitignored — never commit it or the keystore.
#
# Generate a release keystore (from apps/mobile-relay/app):
#   keytool -genkey -v -keystore release.keystore -alias release \
#     -keyalg RSA -keysize 2048 -validity 10000
# Leave release.keystore in apps/mobile-relay/app/ (path is relative to the app module).
#
RELEASE_STORE_FILE=release.keystore
RELEASE_STORE_PASSWORD=your_keystore_password
RELEASE_KEY_ALIAS=release
RELEASE_KEY_PASSWORD=your_key_password
