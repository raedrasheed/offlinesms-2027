{
  "expo": {
    "name": "OfflineSMS",
    "slug": "offlinesms",
    "version": "2.4.10",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "offlinesms",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": false,
      "requireFullScreen": true,
      "bundleIdentifier": "app.offlinesms.mobile",
      "buildNumber": "26",
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSCameraUsageDescription": "OfflineSMS uses your camera to capture and share photos in conversations.",
        "NSMicrophoneUsageDescription": "OfflineSMS uses your microphone to record and send voice messages.",
        "NSPhotoLibraryUsageDescription": "OfflineSMS accesses your photo library to share images in conversations.",
        "NSPhotoLibraryAddUsageDescription": "OfflineSMS saves received media to your photo library.",
        "NSContactsUsageDescription": "OfflineSMS uses your contacts to help you find and message people.",
        "NSLocationWhenInUseUsageDescription": "OfflineSMS uses your location only when you choose to share a location in a conversation."
      },
      "associatedDomains": [
        "applinks:links.offlinesms.com",
        "applinks:offlinesms.com"
      ]
    },
    "android": {
      "package": "app.offlinesms.mobile",
      "versionCode": 27,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#01A0E1"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_CONTACTS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "links.offlinesms.com",
              "pathPrefix": "/join"
            },
            {
              "scheme": "https",
              "host": "offlinesms.com",
              "pathPrefix": "/join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "output": "static"
    },
    "plugins": [
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#1F7BA8"
        }
      ],
      "expo-font",
      "expo-asset",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsImageWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1
          },
          "androidIntentFilters": [
            "image/*",
            "text/*"
          ]
        }
      ],
      "expo-document-picker",
      "./plugins/withAndroidBackCompatibility"
    ],
    "extra": {
      "eas": {
        "projectId": "f892a98f-8238-49f5-bfd6-0db57d6637d5"
      }
    }
  }
}
