{
  "expo": {
    "name": "OfflineSMS",
    "slug": "offlinesms",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "offlinesms",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.offlinesms.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "OfflineSMS uses your camera to capture and share photos in conversations.",
        "NSMicrophoneUsageDescription": "OfflineSMS uses your microphone to record and send voice messages.",
        "NSPhotoLibraryUsageDescription": "OfflineSMS accesses your photo library to share images in conversations.",
        "NSPhotoLibraryAddUsageDescription": "OfflineSMS saves received media to your photo library.",
        "NSContactsUsageDescription": "OfflineSMS uses your contacts to help you find and message people."
      },
      "associatedDomains": ["applinks:offlinesms.com"]
    },
    "android": {
      "package": "app.offlinesms.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#01A0E1"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_CONTACTS",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "offlinesms.com", "pathPrefix": "/join" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "output": "static"
    },
    "plugins": [
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#1F7BA8"
        }
      ]
    ]
  }
}