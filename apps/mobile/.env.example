# Get these from Firebase Console → Project Settings → General
# IMPORTANT: the active project is offlinesms-prod-2027 (see .firebaserc).
# Copy the EXACT "storageBucket" value shown in the Firebase web app config —
# projects created from late 2024 onward use the *.firebasestorage.app suffix,
# not *.appspot.com. A wrong bucket makes Firestore work but every Storage
# upload fail (media messages send their metadata but never their binary).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=offlinesms-prod-2027.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=offlinesms-prod-2027
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=offlinesms-prod-2027.firebasestorage.app
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Settings reads the installed version/build from native application metadata.
