# Next.js 14 Dashboard
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=offlinesms-prod.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=offlinesms-prod
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=offlinesms-prod.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Admin-only paths require this server-side service account JSON
FIREBASE_ADMIN_PROJECT_ID=offlinesms-prod
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Bootstrap admin allow-list (comma-separated emails). Used by the /admin
# server guard before any user has been promoted to admin in Firebase Auth
# custom claims. Leave empty in production once an admin claim exists.
BOOTSTRAP_ADMIN_EMAILS=
